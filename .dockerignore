# Keep container contexts lean — build speed and cache hits matter in CI and prod.

# VCS
.git
.gitignore
.gitattributes
.github

# Python build artifacts
__pycache__
*.py[cod]
*.egg-info
.eggs
build
dist
.venv
venv
env
.mypy_cache
.ruff_cache
.pytest_cache
.coverage
htmlcov
.tox

# Docs & meta — not needed inside images
docs
*.md
!README.md
LICENSE
CHANGELOG.md

# Large artifacts — images fetch weights from object storage, never from context
checkpoints
outputs
runs
artifacts
latent_cache
data
datasets
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.mp4
*.tar
*.zip

# Infra / IDE
deployments
terraform
.idea
.vscode
.DS_Store

# Local env files — baked secrets are a production incident waiting to happen
.env
.env.*
*.log
