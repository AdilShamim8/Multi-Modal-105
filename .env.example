# ─────────────────────────────────────────────────────────────────────────────
# Multi-Modal Generation Platform — environment template
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# Last audited: 2026-10-18
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
MM_ENV=development                  # development | staging | production
MM_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
MM_SEED=42

# ── Serving ──────────────────────────────────────────────────────────────────
MM_API_HOST=0.0.0.0
MM_API_PORT=8000
MM_API_WORKERS=4
MM_DEFAULT_SAMPLER=dpm++
MM_DEFAULT_STEPS=30
MM_DEFAULT_GUIDANCE=7.5
MM_MAX_STEPS=100
MM_MAX_BATCH_SIZE=8
MM_SYNC_TIMEOUT_S=30                # upper bound for synchronous generation

# ── Queue (Redis) ────────────────────────────────────────────────────────────
MM_REDIS_URL=redis://localhost:6379/0
MM_QUEUE_NAME=mm:generation:jobs
MM_QUEUE_MAX_DEPTH=10000            # admission control / load-shedding threshold
MM_JOB_TTL_S=86400

# ── Artifact storage (S3-compatible) ─────────────────────────────────────────
MM_ARTIFACT_STORE=local             # local | s3
MM_ARTIFACT_DIR=/var/lib/multimodal/artifacts
MM_S3_BUCKET=multimodal-artifacts
MM_S3_REGION=us-east-1
MM_S3_ENDPOINT=                     # empty for AWS; set for MinIO/R2
MM_S3_PRESIGN_TTL_S=3600
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Model registry ───────────────────────────────────────────────────────────
MM_MODEL_DIR=/var/lib/multimodal/models
MM_T2I_MODEL=t2i-dit-s2             # registry key, see configs/serving.yaml
MM_T2V_MODEL=t2v-dit-b2
MM_T2I_REVISION=v1.0.0
MM_T2V_REVISION=v1.0.0

# ── Safety / moderation ──────────────────────────────────────────────────────
MM_MODERATION_ENABLED=true
MM_MODERATION_MODE=blocklist        # blocklist | classifier | both
MM_MAX_PROMPT_CHARS=2000

# ── Auth ─────────────────────────────────────────────────────────────────────
MM_AUTH_ENABLED=true
MM_API_KEY=changeme-local-dev-key  # dev only; production reads from secret store

# ── Observability ────────────────────────────────────────────────────────────
MM_METRICS_ENABLED=true
MM_TRACING_ENABLED=false
MM_OTEL_ENDPOINT=http://localhost:4317
MM_SERVICE_NAME=multimodal-api

# ── Experiment tracking (training plane) ─────────────────────────────────────
MM_WANDB_MODE=offline               # offline | online | disabled
WANDB_PROJECT=multimodal-agent
WANDB_ENTITY=
